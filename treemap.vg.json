{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 750,
  "height": 450,
  "title": {
    "text": "Recorded Disaster Events by State",
    "subtitle": "Select a year range to compare event counts"
  },
  "data": {
    "url": "data/ExtremeWeather_2.csv",
    "format": {
      "type": "csv"
    }
  },
  "params": [
    {
      "name": "startYear",
      "value": 2010,
      "bind": {
        "input": "range",
        "min": 2010,
        "max": 2021,
        "step": 1,
        "name": "Start year: "
      }
    },
    {
      "name": "endYear",
      "value": 2021,
      "bind": {
        "input": "range",
        "min": 2010,
        "max": 2021,
        "step": 1,
        "name": "End year: "
      }
    }
  ],
  "transform": [
    {
      "calculate": "toDate(datum['Date/Time'])",
      "as": "eventDate"
    },
    {
      "filter": "isValid(datum.eventDate)"
    },
    {
      "calculate": "year(datum.eventDate)",
      "as": "eventYear"
    },
    {
      "filter": "datum.eventYear >= startYear && datum.eventYear <= endYear"
    },
    {
      "filter": "isValid(datum.State) && datum.State != ''"
    },
    {
      "aggregate": [
        {
          "op": "count",
          "as": "EventCount"
        }
      ],
      "groupby": ["State"]
    },
    {
      "calculate": "'root'",
      "as": "parent"
    },
    {
      "treemap": "EventCount",
      "groupby": ["parent"],
      "size": ["width", "height"],
      "method": "squarify"
    }
  ],
  "mark": {
    "type": "rect",
    "stroke": "white",
    "strokeWidth": 2
  },
  "encoding": {
    "x": {
      "field": "x0",
      "type": "quantitative",
      "scale": null,
      "axis": null
    },
    "x2": {
      "field": "x1"
    },
    "y": {
      "field": "y0",
      "type": "quantitative",
      "scale": null,
      "axis": null
    },
    "y2": {
      "field": "y1"
    },
    "color": {
      "field": "EventCount",
      "type": "quantitative",
      "title": "Recorded events",
      "scale": {
        "scheme": "oranges"
      }
    },
    "tooltip": [
      {
        "field": "State",
        "type": "nominal",
        "title": "State"
      },
      {
        "field": "EventCount",
        "type": "quantitative",
        "title": "Recorded events"
      }
    ]
  }
}