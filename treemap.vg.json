{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "width": 750,
  "height": 450,
  "padding": 10,
  "autosize": "pad",

  "signals": [
    {
      "name": "startYear",
      "value": 1800,
      "bind": {
        "input": "range",
        "min": 1800,
        "max": 2021,
        "step": 1,
        "name": "Start year: "
      }
    },
    {
      "name": "endYear",
      "value": 2021,
      "bind": {
        "input": "range",
        "min": 1800,
        "max": 2021,
        "step": 1,
        "name": "End year: "
      }
    }
  ],

  "title": {
    "text": "Australian Disaster Events by Type",
    "subtitle": "Rectangle size represents the number of recorded events",
    "fontSize": 18,
    "subtitleFontSize": 12,
    "anchor": "start"
  },

  "data": [
    {
      "name": "rootNode",
      "values": [
        {
          "id": "root",
          "parent": null,
          "Database": "All types",
          "value": 0
        }
      ]
    },
    {
      "name": "events",
      "url": "data/ExtremeWeather_1.csv",
      "format": {
        "type": "csv"
      },
      "transform": [
        {
          "type": "formula",
          "expr": "toNumber(split(split(datum.startDate, ' ')[0], '/')[2])",
          "as": "eventYear"
        },
        {
          "type": "filter",
          "expr": "isValid(datum.eventYear) && datum.eventYear >= startYear && datum.eventYear <= endYear"
        },
        {
          "type": "filter",
          "expr": "isValid(datum.title) && trim(datum.title) !== ''"
        },
        {
          "type": "formula",
          "expr": "indexof(datum.title, ' - ') >= 0 ? substring(datum.title, 0, indexof(datum.title, ' - ')) : split(datum.title, ' ')[0]",
          "as": "Database"
        },
        {
          "type": "filter",
          "expr": "isValid(datum.Database) && trim(datum.Database) !== ''"
        },
        {
          "type": "aggregate",
          "groupby": ["Database"],
          "ops": ["count"],
          "as": ["EventCount"]
        },
        {
          "type": "formula",
          "expr": "'type_' + datum.Database",
          "as": "id"
        },
        {
          "type": "formula",
          "expr": "'root'",
          "as": "parent"
        },
        {
          "type": "formula",
          "expr": "datum.EventCount",
          "as": "value"
        }
      ]
    },
    {
      "name": "tree",
      "source": ["rootNode", "events"],
      "transform": [
        {
          "type": "stratify",
          "key": "id",
          "parentKey": "parent"
        },
        {
  "type": "treemap",
  "field": "value",
  "sort": {
    "field": "value",
    "order": "descending"
  },
  "method": "squarify",
  "size": [
    {"signal": "width"},
    {"signal": "height"}
  ],
  "padding": 3,
  "round": true,
  "as": ["x0", "y0", "x1", "y1"]
}
      ]
    }
  ],

  "scales": [
    {
      "name": "color",
      "type": "ordinal",
      "domain": {
        "data": "events",
        "field": "Database"
      },
      "range": {
        "scheme": "tableau10"
      }
    }
  ],

  "marks": [
    {
      "type": "rect",
      "from": {
        "data": "tree",
        "transform": [
          {
            "type": "filter",
            "expr": "datum.id !== 'root'"
          }
        ]
      },
      "encode": {
        "enter": {
          "stroke": {"value": "white"},
          "strokeWidth": {"value": 2}
        },
        "update": {
          "fill": {
            "scale": "color",
            "field": "Database"
          },
          "x": {"field": "x0"},
          "y": {"field": "y0"},
          "x2": {"field": "x1"},
          "y2": {"field": "y1"},
          "tooltip": {
            "signal": "{'Disaster type': datum.Database, 'Recorded events': datum.value}"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "tree",
        "transform": [
          {
            "type": "filter",
            "expr": "datum.id !== 'root'"
          }
        ]
      },
      "encode": {
        "enter": {
          "align": {"value": "center"},
          "baseline": {"value": "middle"},
          "fill": {"value": "white"},
          "fontSize": {"value": 14},
          "fontWeight": {"value": "bold"}
        },
        "update": {
          "text": {
            "signal": "datum.Database + '\\n' + format(datum.value, ',') + ' events'"
          },
          "x": {
            "signal": "(datum.x0 + datum.x1) / 2"
          },
          "y": {
            "signal": "(datum.y0 + datum.y1) / 2"
          },
          "opacity": {
            "signal": "(datum.x1 - datum.x0) > 85 && (datum.y1 - datum.y0) > 40 ? 1 : 0"
          }
        }
      }
    }
  ]
}