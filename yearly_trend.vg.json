{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "data/ExtremeWeather_2.csv"
  },
  "transform": [
    {
      "calculate": "toDate(datum['Date/Time'])",
      "as": "eventDate"
    },
    {
      "filter": "isValid(datum.eventDate)"
    },
    {
      "timeUnit": "year",
      "field": "eventDate",
      "as": "year"
    },
    {
      "aggregate": [
        {
          "op": "count",
          "as": "eventCount"
        }
      ],
      "groupby": ["year"]
    }
  ],
  "params": [
    {
      "name": "time_brush",
      "select": {
        "type": "interval",
        "encodings": ["x"]
      }
    }
  ],
  "vconcat": [
    {
      "width": 750,
      "height": 220,
      "title": {
        "text": "Recorded Disaster Events Over Time",
        "subtitle": "Overview: drag across the chart to select a time range"
      },
      "mark": {
        "type": "line",
        "point": {
          "filled": true,
          "size": 65
        },
        "strokeWidth": 3,
        "color": "#d65f45"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "temporal",
          "title": "Year",
          "axis": {
            "format": "%Y",
            "labelAngle": -45
          }
        },
        "y": {
          "field": "eventCount",
          "type": "quantitative",
          "title": "Recorded events",
          "axis": {
            "tickMinStep": 1
          }
        },
        "tooltip": [
          {
            "field": "year",
            "type": "temporal",
            "title": "Year",
            "format": "%Y"
          },
          {
            "field": "eventCount",
            "type": "quantitative",
            "title": "Recorded events"
          }
        ]
      }
    },
    {
      "width": 750,
      "height": 220,
      "title": "Selected Period — Detailed View",
      "transform": [
        {
          "filter": {
            "param": "time_brush"
          }
        }
      ],
      "mark": {
        "type": "line",
        "point": {
          "filled": true,
          "size": 65
        },
        "strokeWidth": 3,
        "color": "#3977a8"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "temporal",
          "title": "Year",
          "axis": {
            "format": "%Y",
            "labelAngle": -45
          }
        },
        "y": {
          "field": "eventCount",
          "type": "quantitative",
          "title": "Recorded events",
          "axis": {
            "tickMinStep": 1
          }
        },
        "tooltip": [
          {
            "field": "year",
            "type": "temporal",
            "title": "Year",
            "format": "%Y"
          },
          {
            "field": "eventCount",
            "type": "quantitative",
            "title": "Recorded events"
          }
        ]
      }
    }
  ],
  "resolve": {
    "scale": {
      "x": "shared",
      "y": "independent"
    }
  }
}